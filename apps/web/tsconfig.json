{
  "extends": "@protos/config/tsconfig/react-library.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".next",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
