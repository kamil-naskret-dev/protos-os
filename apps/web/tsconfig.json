{
  "extends": "@protos/config/tsconfig/react-library.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".next",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["../../packages/ui/src/components/*"],
      "@/lib/utils": ["../../packages/ui/src/lib/utils.ts"],
      "@/hooks/*": ["./hooks/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
